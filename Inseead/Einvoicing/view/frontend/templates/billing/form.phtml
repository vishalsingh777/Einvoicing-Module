<script>
require(['jquery'], function ($) {
    'use strict';
    var SAVE_URL   = '<?= $block->escapeUrl($block->getSaveUrl()) ?>';
    var VERIFY_URL = '<?= $block->escapeUrl($block->getVerifyUrl()) ?>';
    var CHECKOUT_URL = '<?= $block->escapeUrl($block->getCheckoutUrl()) ?>';

    function applyProfile() {
        var profile = $('#financing_profile').val();
        var isB2B = profile === 'sponsored';
        $('#b2c-section').toggle(!isB2B);
        $('#b2b-section, .b2b-only').toggle(isB2B);
        if (isB2B) applyCountryFields($('#country_of_residence').val());
    }

    function applyCountryFields(country) {
        var isFrance = country === 'FR';
        $('#field-siret, #field-siren').toggle(isFrance);
        $('#field-vat').toggle(!isFrance);
        $('#siret').prop('required', isFrance);
        $('#vat_intracommunity_number').prop('required', !isFrance);
    }

    $('#siret').on('input', function () {
        var val = $(this).val().replace(/\D/g,'').substring(0,14);
        $(this).val(val);
        $('#siren').val(val.length >= 9 ? val.substring(0,9) : '');
    });

    function ajaxVerify(data, $feedback, $btn, originalText) {
        data.isAjax = 1;
        $btn.prop('disabled', true).text('Verifying...');
        $feedback.hide();
        $.post(VERIFY_URL, data, function (r) {
            $feedback.removeClass('success error').addClass(r.success ? 'success' : 'error').text(r.message).show();
            if (r.success && r.company_name) $('#company_full_legal_name').val(r.company_name);
            if (r.success && r.siren) $('#siren').val(r.siren);
        }, 'json').always(function () { $btn.prop('disabled', false).text(originalText); });
    }

    $('#btn-verify-siret').on('click', function () {
        ajaxVerify({siret: $('#siret').val(), country: $('#country_of_residence').val()}, $('#siret-feedback'), $(this), 'Verify');
    });
    $('#btn-verify-vat').on('click', function () {
        ajaxVerify({vat_number: $('#vat_intracommunity_number').val(), country: $('#country_of_residence').val()}, $('#vat-feedback'), $(this), 'Verify');
    });

    function submitForm(proceed) {
        $('#btn-save-billing, #btn-proceed').prop('disabled', true);
        $('#einvoicing-messages').hide();
        var data = $('#einvoicing-billing-form').serializeArray();
        data.push({name:'isAjax',value:'1'});
        $.post(SAVE_URL, data, function (r) {
            if (r.success && proceed) { window.location.href = CHECKOUT_URL; }
            else if (r.success) { $('#einvoicing-messages').removeClass('error').addClass('success').text(r.message).show(); }
            else { $('#einvoicing-messages').removeClass('success').addClass('error').text(r.message).show(); }
        }, 'json').always(function () { $('#btn-save-billing, #btn-proceed').prop('disabled', false); });
    }

    $('#btn-save-billing').on('click', function () { submitForm(false); });
    $('#btn-proceed').on('click', function () { submitForm(true); });
    $('#financing_profile').on('change', applyProfile);
    $('#country_of_residence').on('change', function () { applyCountryFields($(this).val()); });
    applyProfile();
});
</script>
